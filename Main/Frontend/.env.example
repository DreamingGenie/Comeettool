# 지정하지 않은 도메인은 아래 전역 설정을 따릅니다.
VITE_USE_MOCK_API=true

# 구현된 API만 실제 서버에 연결하고 나머지 Board 기능은 Mock을 유지합니다.
VITE_USE_MOCK_AUTH_API=false
VITE_USE_MOCK_USER_API=false
VITE_USE_MOCK_BOARD_API=true
VITE_USE_MOCK_SPACE_API=false

# 아직 백엔드에 구현되지 않은 API는 개별 Jira 작업 전까지 Mock을 유지합니다.
VITE_USE_MOCK_PASSWORD_RESET_API=true
VITE_USE_MOCK_USER_WITHDRAW_API=true
VITE_USE_MOCK_USER_SEARCH_API=true

# 실제 API 서버 주소입니다. 마지막 슬래시는 생략합니다.
VITE_API_BASE_URL=http://127.0.0.1:8080
