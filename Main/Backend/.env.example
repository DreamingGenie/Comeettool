# ===== Database (PostgreSQL) =====
DB_URL=jdbc:postgresql://localhost:5432/commonpjt
DB_USERNAME=
DB_PASSWORD=

# ===== Redis =====
REDIS_HOST=localhost
REDIS_PORT=6379

# ===== JWT (RS256) =====
# 키 생성:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out keys/jwt_private.pem
#   openssl pkey -in keys/jwt_private.pem -pubout -out keys/jwt_public.pem
# keys/ 는 gitignore. 공개키(jwt_public.pem)는 협업 서버(Hocuspocus)에 공유.
JWT_PRIVATE_KEY_PATH=keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=keys/jwt_public.pem