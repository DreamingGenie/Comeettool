# ===== Database (PostgreSQL) =====
DB_URL=jdbc:postgresql://localhost:5432/commonpjt
DB_USERNAME=
DB_PASSWORD=

# ===== Redis =====
REDIS_HOST=localhost
REDIS_PORT=6379

# ===== JWT (RS256) =====
# 키는 classpath(resources/keys)에서 로드 → 실행 디렉터리 무관. 각자 생성:
#   cd Main/Backend
#   mkdir -p src/main/resources/keys
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out src/main/resources/keys/jwt_private.pem
#   openssl pkey -in src/main/resources/keys/jwt_private.pem -pubout -out src/main/resources/keys/jwt_public.pem
# *.pem 은 gitignore. 공개키(jwt_public.pem)는 협업 서버(Hocuspocus)에 공유.
# prod는 외부 파일 주입 권장: JWT_PRIVATE_KEY_PATH=file:/secure/path/jwt_private.pem
JWT_PRIVATE_KEY_PATH=classpath:keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=classpath:keys/jwt_public.pem

# ===== Yjs internal API =====
YJS_INTERNAL_BASE_URL=http://localhost:3000
YJS_INTERNAL_TOKEN=local-yjs-internal-token

# ===== Frontend CORS =====
# 쉼표로 구분합니다. 배포 환경에서는 실제 프론트 주소만 지정하세요.
# 예: CORS_ALLOWED_ORIGIN_PATTERNS=https://app.example.com
CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:[*],http://127.0.0.1:[*],http://192.168.*:[*],http://10.*:[*],http://172.*:[*]