
# ================= PostgreSQL DB =====================
PORT=3000
# 로컬 개발 호환용입니다. 설정되어 있으면 아래 분리 변수보다 우선합니다.
DATABASE_URL=postgresql://root:root@localhost:5432/test

# ECS에서는 DATABASE_URL을 설정하지 않고 아래 값을 사용합니다.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=test
DB_USERNAME=root
DB_PASSWORD=root

# 로컬 PostgreSQL은 false로 사용합니다. ECS/RDS 운영 컨테이너는 기본값 true입니다.
DB_SSL_ENABLED=false
# TLS를 켠 로컬 실행에서는 실제 CA 파일 경로로 바꿉니다.
DB_SSL_ROOT_CERT=/app/certs/rds-ca-bundle.pem

# ==================== Spring JWT =====================
SPRING_JWKS_URL=http://localhost:8080/.well-known/jwks.json
JWT_ISSUER=a707-api
JWT_YJS_AUDIENCE=a707-yjs

# ===== Yjs internal API =====
YJS_INTERNAL_BASE_URL=http://localhost:3000
YJS_INTERNAL_TOKEN=local-yjs-internal-token

# ==================== Test ===========================
TEST_PORT=3210
TEST_DATABASE_URL=postgresql://root:root@localhost:5432/test
