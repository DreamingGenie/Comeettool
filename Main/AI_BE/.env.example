# 필수
OPENAI_API_KEY=
# 선택 - OpenAI 호환 엔드포인트. 비우면 SSAFY GMS 게이트웨이(https://gms.ssafy.io/gmsapi/api.openai.com/v1)
# 교육 과정 밖에서는 예: OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_BASE_URL=
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/comeettool

# ECS에서는 DATABASE_URL 대신 a707/dev/rds/ai Secret의 각 키를 주입한다.
# DB_HOST=
# DB_PORT=5432
# DB_NAME=comeettool
# DB_USER=a707_ai_app
# DB_PASSWORD=
# DB_SSL_MODE=verify-full
# DB_SSL_ROOT_CERT=/app/certs/rds-ca-bundle.pem

# 선택 (GPU로 돌릴 때만, 기본값은 DEVICE=cpu, COMPUTE_TYPE=int8)
# STT_MODEL_SIZE=large-v3-turbo
# DEVICE=cuda
# COMPUTE_TYPE=float16

# BE (FastAPI) 전용 - 회의 녹음이 저장된 S3 버킷
S3_BUCKET_NAME=
AWS_REGION=ap-northeast-2
# EC2 IAM 역할로 인증 가능하면 아래 두 개는 비워둬도 됨
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# 선택 - LLM/임베딩 모델 (기본값: LLM_MODEL=gpt-5, EMBEDDING_MODEL=text-embedding-3-small)
# EMBEDDING_MODEL을 바꾸면 벡터 차원도 달라질 수 있어 DB 스키마(rag.py의 EMBEDDING_DIM)도 같이 맞춰야 함
# LLM_MODEL=gpt-5
# EMBEDDING_MODEL=text-embedding-3-small

# 필수 - BE -> AI 내부 호출 인증 (BE가 X-Internal-Token 헤더로 이 값을 보냄, POST /meetings/{meeting_id}/process 에만 적용)
AI_INTERNAL_TOKEN=
